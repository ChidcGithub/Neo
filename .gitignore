# Rust 构建产物
/target

# 编辑器 / 系统
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini

# 自写说明、审计与过程文档只保留本地；法律正文和第三方原始材料除外
/README.md
/tools/*.md
/crates/**/*.md
/vendor/sherpa-onnx-sys/NEO-ASR.md
/docs/*
!/docs/licenses/
/docs/licenses/**/README.md
/docs/licenses/README.md
# MPL 对应源码供给告知，属于发行法律材料而非过程说明
!/docs/licenses/runtime/native-sources/README.md
/docs-pri/

# 本地临时文件
/tmp/
/.tmp/
*.log

# 发行产物；打包中间文件位于已忽略的 target/package/
/dist/

# 下载缓存、随包运行时原料（不进版本库）
/.cache/

# 兼容旧开发目录，避免旧产物被意外提交
/build/
/runtime/

# STT 模型资产（约 240 MB，从 hf-mirror 重新下载，不进版本库）
/crates/neo-stt/assets/

# 唤醒词训练：数据 / 环境 / 产物（合计约 24 GB，可重新下载与训练，不进版本库）
# 保留脚本与配置：dl_*.ps1、hi_neo.yaml、rir_tree.json、rir_files.txt
/wake-training/data/
/wake-training/.venv/
/wake-training/output/
__pycache__/
*.pyc
